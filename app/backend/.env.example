# Copy to .env. NEVER commit .env or real keys.
# Provider: dial (EPAM DIAL, requires EPAM VPN) | openai | anthropic
LLM_PROVIDER=dial
# DIAL deployment name, or the model id for openai/anthropic. List DIAL models:
#   curl -s "https://ai-proxy.lab.epam.com/openai/models" -H "Api-Key: $LLM_API_KEY"
LLM_MODEL=gpt-5.6-terra-2026-07-09
# Optional server-wide key. Personal DIAL keys must NOT be shared; leave empty so each learner
# pastes their own key in the app (sent per request, never stored).
LLM_API_KEY=
DIAL_ENDPOINT=https://ai-proxy.lab.epam.com
DIAL_API_VERSION=2025-04-01-preview
LLM_CALLS_PER_HOUR=60
CCA_DB=cca.db
CORS_ORIGINS=http://localhost:5173
